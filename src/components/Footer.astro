---
import {
	projectLinks,
	siteEmail,
	siteFooterNote,
	siteLinkedIn,
} from '../lib/site.ts';

const year = new Date().getFullYear();
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__inner">
			<div class="site-footer__primary">
				<nav id="contact" class="site-footer__contact" aria-label="Contact">
					<a class="nav-link site-footer__email" href={`mailto:${siteEmail}`}>{siteEmail}</a>
					<a
						class="site-footer__linkedin"
						href={siteLinkedIn}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn (opens in a new tab)"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 448 512"
							aria-hidden="true"
							focusable="false"
						>
							<!-- Font Awesome Free LinkedIn brand icon -->
							<path
								d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"
							></path>
						</svg>
					</a>
				</nav>

				<nav class="site-footer__work" aria-labelledby="footer-work-heading">
					<h2 id="footer-work-heading" class="text-accent site-footer__work-heading">Projects</h2>
					<ul class="site-footer__work-list">
						{
							projectLinks.map((item) => (
								<li>
									<a
										class="site-footer__work-link"
										href={item.href}
										aria-current={pathname === item.href ? 'page' : undefined}
									>
										{item.label}
										<svg
											class="site-footer__work-arrow"
											viewBox="0 0 24 24"
											aria-hidden="true"
											focusable="false"
										>
											<path
												d="M5 12h14M13 6l6 6-6 6"
												fill="none"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"
												stroke-linejoin="round"
											></path>
										</svg>
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>

			<hr class="site-footer__divider" />

			<div class="site-footer__closing">
				<p class="site-footer__meta text-caption">
					{siteFooterNote}
				</p>
				<p class="site-footer__copyright text-caption">
					Copyright &copy; {year} Matthew Ward
				</p>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding-block: var(--space-section);
	}

	.site-footer__inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: var(--space-lg);
		text-align: left;
	}

	.site-footer__primary {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--space-lg);
		width: 100%;
	}

	.site-footer__contact {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		align-self: flex-end;
		gap: 0;
	}

	.site-footer__work {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		width: 100%;
	}

	@media (min-width: 48rem) {
		.site-footer__primary {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;
			gap: var(--space-lg);
		}

		.site-footer__contact {
			order: 1;
			align-self: flex-start;
			flex-shrink: 0;
		}

		.site-footer__work {
			flex: 1 1 auto;
			width: auto;
			min-width: 0;
		}
	}

	.site-footer__work-heading {
		margin: 0;
		font-size: var(--font-size-nav);
		font-weight: var(--font-weight-bold);
		letter-spacing: var(--letter-spacing-body);
		line-height: 1.35;
		text-transform: none;
	}

	.site-footer__work-list {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-xs);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__work-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding-block: var(--space-2xs);
		font-size: var(--font-size-nav);
		font-weight: var(--font-weight-regular);
		letter-spacing: var(--letter-spacing-body);
		color: var(--color-text);
		text-decoration: none;
		transition: var(--transition-nav);
	}

	.site-footer__work-arrow {
		width: 0.85rem;
		height: 0.85rem;
		flex-shrink: 0;
		transition: transform 200ms ease;
	}

	.site-footer__work-link:hover,
	.site-footer__work-link:focus-visible,
	.site-footer__work-link[aria-current='page'] {
		color: var(--color-project);
	}

	.site-footer__work-link:hover .site-footer__work-arrow,
	.site-footer__work-link:focus-visible .site-footer__work-arrow {
		transform: translateX(0.25rem);
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer__work-arrow {
			transition: none;
		}
	}

	.site-footer__email {
		overflow-wrap: anywhere;
		padding-inline: 0;
		padding-block: var(--space-2xs);
		text-align: right;
	}

	.site-footer__linkedin {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		flex-shrink: 0;
		min-width: 2.75rem;
		min-height: 2.75rem;
		padding: var(--space-2xs) 0 0;
		color: var(--color-text);
		text-decoration: none;
		transition: var(--transition-nav);
	}

	.site-footer__linkedin:hover {
		color: var(--color-project);
	}

	.site-footer__linkedin:focus-visible {
		color: var(--color-accent);
		outline: 3px solid var(--color-focus);
		outline-offset: 2px;
	}

	.site-footer__linkedin svg {
		width: 1.5rem;
		height: 1.5rem;
		fill: currentColor;
	}

	.site-footer__meta {
		margin: 0;
		text-align: center;
	}

	.site-footer__divider {
		width: 100%;
		margin: 0;
		border: 0;
		border-top: 1px solid var(--color-border);
	}

	.site-footer__closing {
		align-self: stretch;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xs);
		text-align: center;
	}

	.site-footer__copyright {
		margin: 0;
		text-align: center;
	}
</style>
