---
import { Image } from 'astro:assets';
import shopifyThumb from '../assets/projects/case-study-thumbnails/shopify-theme.png';
import bondfireThumb from '../assets/projects/case-study-thumbnails/bondfire-design-company.png';
import aiThumb from '../assets/projects/case-study-thumbnails/ai-assisted-websites.png';
import auditsThumb from '../assets/projects/case-study-thumbnails/shopify-accessibility-audits.png';
import graphicThumb from '../assets/projects/case-study-thumbnails/graphic-print-photography.png';

const projects = [
	{
		title: 'Shopify theme architecture',
		tags: 'Shopify + Liquid + JavaScript + Front-end architecture',
		body: 'I manage one shared Shopify theme that hundreds of storefronts run on. I design the layouts, write the copy, install the apps, and ship the updates. After a site goes live I investigate issues, build custom pages, and make design or code improvements that then live in the theme.',
		href: '/projects/shopify-theme-architecture',
		image: shopifyThumb,
		imageAlt:
			'Responsive pet grooming website shown on desktop monitor and smartphone, featuring dog photos, blue navigation, and a clean, professional design.',
	},
	{
		title: 'Bondfire Design Company',
		tags: 'Brand strategy + Visual identity + UX/UI + Web design',
		body: 'I built Bondfire Design Company from the ground up, developing its visual identity, brand system, and digital experience. From the logo and visual language to the website itself, every piece was designed to create a cohesive expression of how I approach design and development.',
		href: '/projects/bondfire-design-company',
		image: bondfireThumb,
		imageAlt:
			'Open silver laptop displaying a modern business website with a dark hero banner, professional photo, and clean white content sections.',
	},
	{
		title: 'AI-assisted websites',
		tags: 'Cursor + AI-assisted development + Accessibility',
		body: 'I use AI-assisted development to design and build production-ready sites for local retailers. A shared API I own feeds live locations, offers, and events; I own the architecture, design, accessibility, performance, and everything else that ships.',
		href: '/projects/ai-assisted-websites',
		image: aiThumb,
		imageAlt:
			'Angled silver laptop on a light background displays a web article about pet brands, with a dog photo and red call-to-action button.',
	},
	{
		title: 'Shopify accessibility audits',
		tags: 'WCAG 2.1 + WAVE + Lighthouse + Manual testing',
		body: 'I audit every Shopify storefront for accessibility errors and contrast failures before it goes live, then turn findings into frontend improvements. When a barrier lives in a shared component, I fix it in the theme so the next site inherits the work.',
		href: '/projects/shopify-accessibility-audits',
		image: auditsThumb,
		imageAlt:
			'Floating smartphones and tablet screens show online shopping pages, product photos, and forms against a calm teal background, suggesting digital commerce.',
	},
	{
		title: 'Graphic design, print & photography',
		tags: 'Adobe Creative Suite + Print design + Photography',
		body: 'Graphic design, print, and photography from client work and personal projects. I focus on composition and hierarchy so the work holds up on a page, in a room, in a feed, and in a frame.',
		href: '/projects/graphic-print-photography',
		image: graphicThumb,
		imageAlt:
			'Illustration of “Websites that Attract More Local Customers,” featuring a pet shop, shoppers with a dog, and local search marketing panels.',
	},
];

const skillGroups = [
	{
		label: 'Front-end development',
		skills: ['Shopify', 'Liquid', 'JavaScript', 'HTML', 'CSS', 'Git'],
	},
	{
		label: 'Design & UX',
		skills: ['Visual design', 'Brand identity', 'UX/UI', 'Adobe Creative Suite'],
	},
	{
		label: 'Accessibility & quality',
		skills: ['WCAG 2.1', 'WAVE', 'Manual testing', 'Performance'],
	},
	{
		label: 'Platforms',
		skills: ['Shopify', 'WordPress', 'Webflow', 'HubSpot'],
	},
];

const careerSteps = [
	{
		title: 'Digital Marketing Support Specialist',
		detail: '2020–2021',
	},
	{
		title: 'Web Designer',
		detail: '2021–2022',
	},
	{
		title: 'Front-end Web Designer & Developer',
		detail: '2022–Present',
	},
];
---

<section id="projects" class="philosophy section-block" aria-label="Projects and resume">
	<div class="container">
		<div class="project-strip-wrap">
			<nav class="project-strip" aria-label="Selected work previews">
				{
					projects.map((item) => (
						<a class="project-strip__link" href={item.href}>
							<span class="project-strip__frame">
								<Image
									class="project-strip__media"
									src={item.image}
									alt={item.imageAlt ?? ''}
									widths={[160, 240, 320, 480, 720]}
									sizes="(min-width: 64rem) 18vw, (min-width: 48rem) 30vw, 88vw"
								/>
								<span class="project-strip__overlay" aria-hidden="true">View Case Study</span>
							</span>
							<span class="project-strip__label">{item.title}</span>
						</a>
					))
				}
			</nav>
			<p class="project-strip__cue" aria-hidden="true">
				<span class="project-strip__cue-label">Swipe</span>
				<span class="project-strip__cue-arrow">→</span>
			</p>
		</div>

		<div class="content-grid">
			<section class="content-grid__column" aria-labelledby="philosophy-heading">
				<div class="heading-block">
					<p class="text-accent section-label">What I do</p>
					<h2 id="philosophy-heading">Websites, assets, and experiences.</h2>
					<p class="philosophy__intro">
						Day to day I manage one shared Shopify theme for hundreds of retailers. I
						design and build on it, and I support the stores that run on it.
					</p>
				</div>

				<div class="accordion">
					{
						projects.map((item, index) => (
							<details
								class:list={['accordion__item', { 'is-open': index === 0 }]}
								open={index === 0}
								data-accordion
							>
								<summary class="accordion__summary">
									<span class="accordion__title">{item.title}</span>
									<span class="accordion__icon" aria-hidden="true">
										+
									</span>
								</summary>
								<div class="accordion__content">
									<div class="accordion__panel">
										<p class="tag-line accordion__tags">{item.tags}</p>
										<p class="accordion__body">{item.body}</p>
										<a
											class="btn"
											href={item.href}
											aria-label={`View case study: ${item.title}`}
										>
											View Case Study
										</a>
									</div>
								</div>
							</details>
						))
					}
				</div>
			</section>

			<section id="resume" class="content-grid__column" aria-labelledby="resume-heading">
				<div class="heading-block">
					<p class="text-accent section-label">Why me</p>
					<h2 id="resume-heading">Designing from passion, coding from curiosity.</h2>
					<div class="content-copy">
						<p>
							I used to do my best work in design, and I was happy there. Then I
							realized I didn't like sending my vision off to be finished by someone
							else. I was too curious. I wanted to own how something looks and
							understand how it gets built, and the journey grew from there.
						</p>
						<p>
							Now I do my best work sitting with design and development on the same
							problem. I'll wear whatever hat the work needs, whether that's the
							layout, the build, or the fix after it ships, because I'd rather stay on
							it than hand it off. I love to think big picture — it's a puzzle. Creating shared pieces so a
							layout can work for hundreds of stores, not just one, is the reward.
						</p>
						<p>
							I think I'm picky in a useful way: before something ships I check it,
							click through it, and look at both the whole page and the small stuff.
							That's how I like the design to reach people, and how I know it will hold
							up.
						</p>
					</div>
				</div>

				<ol class="career-timeline" aria-label="Career path">
					{
						careerSteps.map((step) => (
							<li class="career-timeline__item">
								<span class="career-timeline__marker" aria-hidden="true"></span>
								<span class="career-timeline__copy">
									<span class="career-timeline__label">{step.title}</span>
									<span class="career-timeline__detail">{step.detail}</span>
								</span>
							</li>
						))
					}
				</ol>

				<div class="skill-groups">
					{
						skillGroups.map((group) => (
							<div class="skill-group">
								<h3 class="text-accent skill-group__label">{group.label}</h3>
								<p class="tag-line skill-group__skills">{group.skills.join(' + ')}</p>
							</div>
						))
					}
				</div>

				<a class="btn" href="/resume.pdf" download="Matthew-Ward-Resume.pdf">
					Download Resume
				</a>
			</section>
		</div>
	</div>
</section>

<style>
	.philosophy.section-block {
		padding-block-start: 0;
	}

	.philosophy {
		padding-block-end: var(--space-lg);
	}

	.project-strip-wrap {
		position: relative;
		margin-block: var(--space-lg) var(--space-xl);
	}

	.project-strip {
		display: flex;
		gap: var(--space-sm);
		margin-inline-end: calc(-1 * var(--container-padding));
		padding-inline-end: var(--container-padding);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: 0;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.project-strip::-webkit-scrollbar {
		display: none;
	}

	.project-strip__link {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		flex: 0 0 calc(100% - 1.75rem);
		min-width: 0;
		text-decoration: none;
		color: inherit;
		scroll-snap-align: start;
		scroll-snap-stop: always;
	}

	.project-strip__cue {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.35rem;
		margin: var(--space-sm) 0 0;
		padding-inline-end: 0.15rem;
		font-size: var(--font-size-caption);
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--letter-spacing-body);
		color: var(--color-text-subtle);
		transition: opacity 200ms ease;
	}

	.project-strip__cue.is-hidden {
		opacity: 0;
	}

	.project-strip__cue-arrow {
		display: inline-block;
		animation: project-strip-cue 1.6s ease-in-out infinite;
	}

	@keyframes project-strip-cue {
		0%,
		100% {
			transform: translateX(0);
		}
		50% {
			transform: translateX(0.35rem);
		}
	}

	.project-strip__link:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 2px;
		border-radius: var(--radius-md);
	}

	.project-strip__frame {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: var(--radius-md);
	}

	.project-strip__media {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		object-position: center;
		background-color: var(--color-surface-muted);
	}

	.project-strip__overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-sm);
		background-color: color-mix(in srgb, var(--color-text) 55%, transparent);
		color: var(--color-background);
		font-size: var(--font-size-caption);
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--letter-spacing-body);
		text-align: center;
		opacity: 0;
		transition: opacity 450ms ease-in-out;
	}

	.project-strip__link:hover .project-strip__overlay,
	.project-strip__link:focus-visible .project-strip__overlay {
		opacity: 1;
	}

	.project-strip__label {
		font-size: var(--font-size-caption);
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--letter-spacing-body);
		line-height: 1.35;
		text-wrap: balance;
		color: var(--color-text);
		transition: color var(--transition-nav);
	}

	@media (hover: hover) {
		.project-strip__link:hover .project-strip__label {
			color: var(--color-project);
		}
	}

	@media (min-width: 48rem) {
		.project-strip {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			margin-inline-end: 0;
			padding-inline-end: 0;
			overflow: visible;
			scroll-snap-type: none;
		}

		.project-strip__link {
			flex: initial;
			scroll-snap-stop: normal;
		}

		.project-strip__cue {
			display: none;
		}
	}

	@media (min-width: 64rem) {
		.project-strip {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}
	}

	/* Accordion */

	.accordion {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.accordion__item {
		border-radius: var(--radius-md);
		border: 1px solid color-mix(in srgb, var(--color-text) 24%, white);
		background-color: var(--color-background);
	}

	.accordion__summary:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 2px;
		border-radius: var(--radius-md);
	}

	.accordion__summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		padding: var(--space-md);
		cursor: pointer;
		list-style: none;
	}

	.accordion__summary::-webkit-details-marker {
		display: none;
	}

	.accordion__title {
		font-weight: var(--font-weight-bold);
		letter-spacing: var(--letter-spacing-body);
	}

	.accordion__icon {
		flex-shrink: 0;
		font-size: 1.25rem;
		font-weight: var(--font-weight-regular);
		line-height: 1;
		transition: transform 500ms ease-in-out;
	}

	.accordion__item.is-open .accordion__icon {
		transform: rotate(45deg);
	}

	.accordion__content {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows var(--transition-accordion);
	}

	.accordion__item.is-open .accordion__content {
		grid-template-rows: 1fr;
	}

	.accordion__panel {
		overflow: hidden;
		min-height: 0;
		padding: 0 var(--space-md) var(--space-md);
		opacity: 0;
		transition: opacity var(--transition-accordion);
	}

	.accordion__item.is-open .accordion__panel {
		opacity: 1;
	}

	.accordion__tags {
		margin: 0 0 var(--space-sm);
	}

	.accordion__body {
		margin: 0 0 var(--space-md);
	}

	/* Career timeline */

	#resume {
		container-type: inline-size;
	}

	.career-timeline {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.career-timeline__item {
		position: relative;
		display: grid;
		grid-template-columns: 0.5rem minmax(0, 1fr);
		column-gap: var(--space-sm);
		align-items: start;
	}

	.career-timeline__item:not(:last-child) {
		padding-bottom: var(--space-sm);
	}

	.career-timeline__item:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 0.75rem;
		left: calc(0.25rem - 1px);
		width: 2px;
		height: calc(100% - 0.75rem);
		background-color: var(--color-border);
	}

	.career-timeline__marker {
		position: relative;
		z-index: 1;
		width: 0.5rem;
		height: 0.5rem;
		margin-top: 0.25rem;
		border-radius: 50%;
		background-color: var(--color-border);
	}

	.career-timeline__item:last-child .career-timeline__marker {
		background-color: var(--color-project);
	}

	.career-timeline__copy {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		min-width: 0;
	}

	.career-timeline__label {
		min-width: 0;
		font-size: var(--font-size-caption);
		font-weight: var(--font-weight-semibold);
		letter-spacing: var(--letter-spacing-body);
		line-height: 1.35;
		text-wrap: balance;
		color: var(--color-text-subtle);
	}

	.career-timeline__item:last-child .career-timeline__label {
		color: var(--color-project);
	}

	.career-timeline__detail {
		font-size: var(--font-size-caption);
		font-weight: var(--font-weight-regular);
		letter-spacing: var(--letter-spacing-body);
		line-height: 1.35;
		color: var(--color-text-subtle);
	}

	.career-timeline__item:last-child .career-timeline__detail {
		color: var(--color-text-subtle);
	}

	@container (min-width: 24rem) {
		.career-timeline {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.career-timeline__item {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-xs);
			padding-bottom: 0;
			text-align: center;
		}

		.career-timeline__item:not(:last-child)::after {
			top: 0.25rem;
			left: calc(50% + 0.5rem);
			width: calc(100% - 1rem);
			height: 2px;
		}

		.career-timeline__marker {
			margin-top: 0;
		}
	}

	/* Skills */

	.skill-groups {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.skill-group__label {
		margin: 0 0 var(--space-xs);
		font-size: var(--font-size-body);
		text-transform: none;
	}

	.skill-group__skills {
		margin: 0;
	}
</style>

<script>
	function setAccordionExpanded(details, isOpen) {
		details.classList.toggle('is-open', isOpen);
	}

	function nextAccordionToken(details) {
		const token = String(Number(details.dataset.accordionToken || '0') + 1);
		details.dataset.accordionToken = token;
		return token;
	}

	function waitForTransition(element, propertyName) {
		return new Promise((resolve) => {
			const timeout = window.setTimeout(resolve, 500);

			element.addEventListener(
				'transitionend',
				(event) => {
					if (event.propertyName !== propertyName) return;
					window.clearTimeout(timeout);
					resolve(undefined);
				},
				{ once: true },
			);
		});
	}

	async function closeAccordion(details) {
		const summary = details.querySelector('.accordion__summary');
		const content = details.querySelector('.accordion__content');
		if (!(summary instanceof HTMLElement) || !(content instanceof HTMLElement)) return;
		if (!details.classList.contains('is-open') && !details.open) return;

		const token = nextAccordionToken(details);
		details.dataset.animating = 'true';

		setAccordionExpanded(details, false);
		await waitForTransition(content, 'grid-template-rows');
		if (details.dataset.accordionToken !== token) return;

		details.open = false;
		details.dataset.animating = 'false';
	}

	async function openAccordion(details) {
		const summary = details.querySelector('.accordion__summary');
		const content = details.querySelector('.accordion__content');
		if (!(summary instanceof HTMLElement) || !(content instanceof HTMLElement)) return;

		const token = nextAccordionToken(details);
		details.dataset.animating = 'true';

		details.open = true;
		await new Promise(requestAnimationFrame);
		if (details.dataset.accordionToken !== token) return;

		setAccordionExpanded(details, true);
		await waitForTransition(content, 'grid-template-rows');
		if (details.dataset.accordionToken !== token) return;

		details.dataset.animating = 'false';
	}

	function setupAccordions() {
		document.querySelectorAll('[data-accordion]').forEach((details) => {
			if (details.dataset.accordionInit === 'true') return;
			details.dataset.accordionInit = 'true';

			const summary = details.querySelector('.accordion__summary');
			if (!(summary instanceof HTMLElement)) return;

			summary.addEventListener('click', async (event) => {
				event.preventDefault();
				if (details.dataset.animating === 'true') return;

				const group = details.closest('.accordion');
				const wasOpen = details.classList.contains('is-open');
				const others = group
					? [...group.querySelectorAll('[data-accordion]')].filter(
							(item) => item !== details && (item.classList.contains('is-open') || item.open),
						)
					: [];

				if (wasOpen) {
					await closeAccordion(details);
					return;
				}

				await Promise.all([...others.map((item) => closeAccordion(item)), openAccordion(details)]);
			});
		});
	}

	function setupProjectStripCue() {
		const wrap = document.querySelector('.project-strip-wrap');
		const strip = wrap?.querySelector('.project-strip');
		const cue = wrap?.querySelector('.project-strip__cue');
		if (
			!(wrap instanceof HTMLElement) ||
			!(strip instanceof HTMLElement) ||
			!(cue instanceof HTMLElement) ||
			strip.dataset.cueInit === 'true'
		) {
			return;
		}

		strip.dataset.cueInit = 'true';

		const updateCue = () => {
			cue.classList.toggle('is-hidden', strip.scrollLeft > 16);
		};

		updateCue();
		strip.addEventListener('scroll', updateCue, { passive: true });
	}

	setupAccordions();
	setupProjectStripCue();
	document.addEventListener('astro:page-load', setupAccordions);
	document.addEventListener('astro:page-load', setupProjectStripCue);
</script>

