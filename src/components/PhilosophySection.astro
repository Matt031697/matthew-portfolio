---
import { Image } from 'astro:assets';
import shopifyThumb from '../assets/projects/case-study-thumbnails/shopify-theme.png';
import bondfireThumb from '../assets/projects/case-study-thumbnails/bondfire-design-company.png';
import aiThumb from '../assets/projects/case-study-thumbnails/ai-assisted-websites.png';
import auditsThumb from '../assets/projects/case-study-thumbnails/shopify-accessibility-audits.png';
import graphicThumb from '../assets/projects/case-study-thumbnails/graphic-print-photography.png';
const projects = [
	{
		title: 'Shopify theme architecture',
		tags: 'Shopify + Liquid + JavaScript + Front-end architecture',
		body: 'I manage one shared Shopify theme that 500+ storefronts run on. I design the layouts, write the copy, install the apps, and ship the updates. After a site goes live I investigate issues, build custom pages, and make design or code improvements that then live in the theme.',
		href: '/projects/shopify-theme-architecture',
		image: shopifyThumb,
		imageAlt:
			'Responsive pet grooming website shown on desktop monitor and smartphone, featuring dog photos, blue navigation, and a clean, professional design.',
	},
	{
		title: 'Bondfire Design Company',
		tags: 'Brand strategy + Visual identity + UX/UI + Web design',
		body: 'I started Bondfire Design Company so owners at any size could get identity, a website, and marketing that still sweat the details. It is my own brand and client work, start to finish.',
		href: '/projects/bondfire-design-company',
		image: bondfireThumb,
		imageAlt:
			'Open silver laptop displaying a modern business website with a dark hero banner, professional photo, and clean white content sections.',
	},
	{
		title: 'Companion sites',
		tags: 'Astro + Shared system + Accessibility',
		body: 'Companion sites for local businesses that do not match a templated program. I use one shared Astro system across 60+ live sites so each store still feels like itself. Design, architecture, and accessibility stay mine.',
		href: '/projects/companion-sites',
		image: aiThumb,
		imageAlt:
			'Angled silver laptop on a light background displays a web article about pet brands, with a dog photo and red call-to-action button.',
	},
	{
		title: 'Shopify accessibility audits',
		tags: 'WCAG 2.2 + WAVE + Lighthouse + Manual testing',
		body: 'I make sure every storefront is accessible before it ships. Assessments, quality checks, and changes happen first. When the barrier lives in a shared component, I fix it in the theme so the next site inherits the work.',
		href: '/projects/shopify-accessibility-audits',
		image: auditsThumb,
		imageAlt:
			'Floating smartphones and tablet screens show online shopping pages, product photos, and forms against a calm teal background, suggesting digital commerce.',
	},
	{
		title: 'Graphic design, print & photography',
		tags: 'Adobe Creative Suite + Print design + Photography',
		body: 'I make graphic design, print, and photography for people and businesses who needed work they could hold, walk past, or photograph. I design and develop for the screen too. There is no preview button on a booth or a poster. I care about composition and hierarchy so the piece holds up in both places.',
		href: '/projects/graphic-print-photography',
		image: graphicThumb,
		imageAlt:
			'Illustration of “Websites that Attract More Local Customers,” featuring a pet shop, shoppers with a dog, and local search marketing panels.',
	},
];

const skillGroups = [
	{
		label: 'Front-end development',
		skills: ['Liquid', 'JavaScript', 'HTML', 'CSS', 'Git'],
	},
	{
		label: 'Design & UX',
		skills: ['Visual design', 'Brand identity', 'UX/UI', 'Adobe Creative Suite'],
	},
	{
		label: 'Accessibility & quality',
		skills: ['WCAG 2.2', 'WAVE', 'Manual testing', 'Performance'],
	},
	{
		label: 'Platforms',
		skills: ['Shopify', 'WordPress', 'Webflow', 'HubSpot'],
	},
];
---

<section id="projects" class="work section-block" aria-labelledby="philosophy-heading">
	<div class="container">
		<div class="heading-block work__intro">
			<p class="text-accent section-label">What I do</p>
			<h2 id="philosophy-heading">Some days it's one theme. Some days it's everything in-between.</h2>
			<p class="philosophy__intro">
				I typically work in a shared component system that 500+ stores run
				on. But the tasks inside it still show up as their own jobs. A specific
				layout, copy that fits the store, a fix or an upgrade, a page only one
				store needs. Independent work, same place.
			</p>
		</div>

		<div class="work-picker" data-project-card>
			<div class="work-picker__media">
				<div class="work-picker__frame">
					{
						projects.map((item, index) => (
							<Image
								class:list={['work-picker__image', { 'is-visible': index === 0 }]}
								src={item.image}
								alt={item.imageAlt}
								widths={[320, 480, 720, 960, 1200]}
								sizes="(min-width: 64rem) 52vw, 100vw"
								loading={index === 0 ? 'eager' : 'lazy'}
								fetchpriority={index === 0 ? 'high' : 'auto'}
								data-project-image
							/>
						))
					}
				</div>
				<div class="work-picker__controls">
					<button
						type="button"
						class="work-picker__arrow"
						data-project-prev
						aria-label="Previous project"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M14 6 8 12l6 6"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							></path>
						</svg>
					</button>
					<div class="work-picker__sheet" role="tablist" aria-label="Projects">
						{
							projects.map((item, index) => (
								<button
									type="button"
									class="work-picker__thumb"
									role="tab"
									id={`project-tab-${index}`}
									aria-controls="project-panel"
									aria-label={item.title}
									aria-selected={index === 0 ? 'true' : 'false'}
									tabindex={index === 0 ? 0 : -1}
									data-project-title={item.title}
									data-project-tags={item.tags}
									data-project-body={item.body}
									data-project-href={item.href}
								>
									<Image
										class="work-picker__thumb-image"
										src={item.image}
										alt=""
										widths={[120, 200, 320]}
										sizes="12vw"
									/>
								</button>
							))
						}
					</div>
					<button
						type="button"
						class="work-picker__arrow"
						data-project-next
						aria-label="Next project"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M10 6l6 6-6 6"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							></path>
						</svg>
					</button>
				</div>
			</div>

			<div class="work-picker__copy-wrap">
				<div class="work-picker__sizer" aria-hidden="true">
					{
						projects.map((item) => (
							<div class="work-picker__sizer-item">
								<h3 class="work-picker__title">{item.title}</h3>
								<p class="tag-line work-picker__tags">{item.tags}</p>
								<p class="work-picker__body">{item.body}</p>
								<span class="btn">View Case Study</span>
							</div>
						))
					}
				</div>
				<div
					class="work-picker__copy"
					id="project-panel"
					role="tabpanel"
					aria-labelledby="project-tab-0"
					tabindex="0"
				>
					<h3 class="work-picker__title">{projects[0].title}</h3>
					<p class="tag-line work-picker__tags">{projects[0].tags}</p>
					<p class="work-picker__body">{projects[0].body}</p>
					<a
						class="btn"
						href={projects[0].href}
						data-project-cta
						aria-label={`View case study: ${projects[0].title}`}
					>
						View Case Study
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<section id="resume" class="why section-block" aria-labelledby="resume-heading">
	<div class="container">
		<div class="heading-block why__intro">
			<p class="text-accent section-label">Why me</p>
			<h2 id="resume-heading">Designing from passion, coding from curiosity.</h2>
		</div>

		<div class="content-grid">
			<div class="content-copy">
				<p>
					I used to do my best work in design, and I was happy there. Then I
					got curious about the other half. I wanted to sit with how something
					looks and how it gets built, and the journey grew from there.
				</p>
				<p>
					Now I do my best work when design and development sit on the same
					problem. I'll wear whatever hat the work needs, whether that's the
					layout, the build, or the fix after it ships. I love to think big
					picture. It's a puzzle. Creating shared pieces so a layout can work
					across stores, not just one, is the reward.
				</p>
				<p>
					I think I'm careful in a useful way: before something ships I check it,
					click through it, and look at both the whole page and the small stuff.
					That's how I know it will hold up for people.
				</p>
			</div>

			<div class="why__skills">
				<div class="why__skills-stack">
					<p class="text-accent section-label why__skills-label">Skills</p>
					<div class="skill-groups">
						{
							skillGroups.map((group) => (
								<div class="skill-group">
									<h3 class="skill-group__label">{group.label}</h3>
									<p class="tag-line skill-group__skills">{group.skills.join(' + ')}</p>
								</div>
							))
						}
					</div>
				</div>

				<a class="btn" href="/resume.pdf" download="Matthew-Ward-Resume.pdf">
					Download My Resume
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.work-picker {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-lg);
		align-items: start;
	}

	@media (min-width: 64rem) {
		.work-picker {
			grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.8fr);
			gap: var(--space-xl);
			align-items: start;
		}

		.why .content-grid {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
			gap: var(--space-xl);
		}
	}

	.why .content-copy {
		max-width: 65ch;
	}

	.philosophy__intro {
		max-width: 62ch;
	}

	.work__intro {
		max-width: 56rem;
		margin-bottom: var(--space-md);
	}

	.work-picker__media {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.work-picker__frame {
		position: relative;
		overflow: hidden;
		aspect-ratio: 2 / 1;
		background-color: var(--color-surface-muted);
	}

	.work-picker__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0;
		transition: opacity 350ms ease;
	}

	.work-picker__image.is-visible {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.work-picker__image {
			transition: none;
		}
	}

	.work-picker__controls {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
	}

	.work-picker__title {
		margin: 0;
		font-size: var(--font-size-h3);
		font-weight: var(--font-weight-bold);
		letter-spacing: var(--letter-spacing-heading);
		line-height: var(--line-height-heading);
		text-wrap: balance;
	}

	.work-picker__arrow {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 2.75rem;
		height: 2.75rem;
		margin: 0;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
	}

	.work-picker__arrow svg {
		width: 1.125rem;
		height: 1.125rem;
	}

	.work-picker__arrow:hover,
	.work-picker__arrow:focus-visible {
		background-color: color-mix(in srgb, var(--color-text) 6%, transparent);
		color: var(--color-project);
	}

	.work-picker__arrow:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 2px;
	}

	.work-picker__sheet {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		flex: 1;
		gap: 0.5rem;
		min-width: 0;
	}

	.work-picker__thumb {
		display: block;
		width: 100%;
		margin: 0;
		padding: 0;
		overflow: hidden;
		aspect-ratio: 1;
		border: none;
		border-radius: 0;
		background: var(--color-surface-muted);
		box-shadow: none;
		cursor: pointer;
	}

	.work-picker__thumb:hover .work-picker__thumb-image,
	.work-picker__thumb:focus-visible .work-picker__thumb-image {
		opacity: 1;
	}

	.work-picker__thumb:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 3px;
	}

	.work-picker__thumb-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.62;
		transition: opacity 200ms ease;
	}

	.work-picker__thumb[aria-selected='true'] .work-picker__thumb-image {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.work-picker__thumb-image {
			transition: none;
		}
	}

	.work-picker__copy-wrap {
		display: grid;
		align-items: start;
	}

	.work-picker__sizer,
	.work-picker__copy {
		grid-area: 1 / 1;
	}

	.work-picker__sizer {
		display: grid;
		visibility: hidden;
		pointer-events: none;
	}

	.work-picker__sizer-item {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-sm);
	}

	.work-picker__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-sm);
	}

	.work-picker__copy:focus {
		outline: none;
	}

	.work-picker__copy:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 4px;
	}

	.work-picker__tags,
	.work-picker__body {
		margin: 0;
	}

	.why__intro {
		margin-bottom: var(--space-md);
	}

	.why__skills {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-md);
	}

	.why__skills-stack {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-xs);
	}

	.why__skills-label {
		margin: 0;
		font-weight: var(--font-weight-bold);
	}
</style>

<script>
	function setupProjectPicker() {
		const card = document.querySelector('[data-project-card]');
		if (!(card instanceof HTMLElement) || card.dataset.pickerInit === 'true') {
			return;
		}

		card.dataset.pickerInit = 'true';
		const tabs = [...card.querySelectorAll('[role="tab"]')].filter(
			(tab) => tab instanceof HTMLButtonElement,
		);
		const images = [...card.querySelectorAll('[data-project-image]')];
		const panel = document.getElementById('project-panel');
		const prev = card.querySelector('[data-project-prev]');
		const next = card.querySelector('[data-project-next]');
		const titleEl = card.querySelector('.work-picker__copy .work-picker__title');
		const tagsEl = card.querySelector('.work-picker__copy .work-picker__tags');
		const bodyEl = card.querySelector('.work-picker__copy .work-picker__body');
		const ctaEl = card.querySelector('[data-project-cta]');

		if (
			tabs.length === 0 ||
			!(panel instanceof HTMLElement) ||
			!(prev instanceof HTMLButtonElement) ||
			!(next instanceof HTMLButtonElement) ||
			!(titleEl instanceof HTMLElement) ||
			!(tagsEl instanceof HTMLElement) ||
			!(bodyEl instanceof HTMLElement) ||
			!(ctaEl instanceof HTMLAnchorElement)
		) {
			return;
		}

		const selectIndex = (index: number, { focus = false }: { focus?: boolean } = {}) => {
			const tab = tabs[index];
			if (!(tab instanceof HTMLButtonElement)) return;

			tabs.forEach((item, itemIndex) => {
				const selected = itemIndex === index;
				item.setAttribute('aria-selected', selected ? 'true' : 'false');
				item.tabIndex = selected ? 0 : -1;
			});

			images.forEach((image, imageIndex) => {
				if (image instanceof HTMLElement) {
					image.classList.toggle('is-visible', imageIndex === index);
				}
			});

			const title = tab.dataset.projectTitle ?? '';
			titleEl.textContent = title;
			tagsEl.textContent = tab.dataset.projectTags ?? '';
			bodyEl.textContent = tab.dataset.projectBody ?? '';
			ctaEl.href = tab.dataset.projectHref ?? '#';
			ctaEl.setAttribute('aria-label', `View case study: ${title}`);
			panel.setAttribute('aria-labelledby', tab.id);

			if (focus) tab.focus();
		};

		const currentIndex = () =>
			Math.max(
				0,
				tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true'),
			);

		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => selectIndex(index));
		});

		prev.addEventListener('click', () => {
			selectIndex((currentIndex() - 1 + tabs.length) % tabs.length);
		});

		next.addEventListener('click', () => {
			selectIndex((currentIndex() + 1) % tabs.length);
		});

		card.addEventListener('keydown', (event) => {
			if (!(event.target instanceof HTMLElement)) return;
			if (!event.target.closest('.work-picker__controls')) return;

			const index = currentIndex();
			let nextIndex = index;
			if (event.key === 'ArrowRight') {
				nextIndex = (index + 1) % tabs.length;
			} else if (event.key === 'ArrowLeft') {
				nextIndex = (index - 1 + tabs.length) % tabs.length;
			} else if (event.key === 'Home') {
				nextIndex = 0;
			} else if (event.key === 'End') {
				nextIndex = tabs.length - 1;
			} else {
				return;
			}

			event.preventDefault();
			selectIndex(nextIndex, { focus: true });
		});
	}

	setupProjectPicker();
	document.addEventListener('astro:page-load', setupProjectPicker);
</script>
