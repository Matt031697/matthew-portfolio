---
import '@fontsource/montserrat/latin-400.css';
import '@fontsource/montserrat/latin-400-italic.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '../styles/global.css';
import { siteEmail, siteLinkedIn, siteLocation, siteName } from '../lib/site.ts';

const faviconAlt =
	'Blue geometric M and W letters interlock in a bold, angular logo on a white background, conveying a clean, modern, professional tone.';

const openGraphImageHref = '/matthew-portfolio-open-graph.png';
const openGraphImageAlt =
	'Light blue share card with “Hi, I’m Matthew” and “Designer & Front-end Developer,” a laptop and stacked phones showing pet-retailer sites, and a large MW mark in the corner.';
const jobTitle = 'Designer & Front-end Developer';

interface Props {
	title?: string;
	description?: string;
	accentColor?: string;
	noindex?: boolean;
}

const {
	title = 'Matthew, Designer & Front-end Developer',
	description = 'Designer and front-end developer. Shopify storefronts, brand identity, accessibility, and campaign work for retailers and local businesses.',
	accentColor,
	noindex = false,
} = Astro.props;

const siteOrigin = Astro.site ?? Astro.url;
const siteUrl = new URL('/', siteOrigin).href;
const pageUrl = new URL(Astro.url.pathname, siteOrigin).href;
const openGraphImageUrl = new URL(openGraphImageHref, siteOrigin).href;
const [addressLocality, addressRegion] = siteLocation.split(', ');

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteUrl}#website`,
			url: siteUrl,
			name: siteName,
			description,
			publisher: { '@id': `${siteUrl}#person` },
		},
		{
			'@type': 'Person',
			'@id': `${siteUrl}#person`,
			name: siteName,
			jobTitle,
			url: siteUrl,
			email: siteEmail,
			image: openGraphImageUrl,
			sameAs: [siteLinkedIn],
			address: {
				'@type': 'PostalAddress',
				addressLocality,
				addressRegion,
				addressCountry: 'US',
			},
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="canonical" href={pageUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={openGraphImageUrl} />
		<meta property="og:image:alt" content={openGraphImageAlt} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="720" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={openGraphImageUrl} />
		<meta name="twitter:image:alt" content={openGraphImageAlt} />
		<link rel="icon" href="/favicon.ico" sizes="48x48" title={faviconAlt} />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" title={faviconAlt} />
		<link rel="apple-touch-icon" href="/favicon.png" title={faviconAlt} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body
		class:list={[accentColor && 'is-project']}
		style={
			accentColor
				? `--color-project: ${accentColor}; --color-accent: ${accentColor}; --color-focus: ${accentColor};`
				: undefined
		}
	>
		<a class="skip-link" href="#main">Skip to main content</a>
		<slot />
	</body>
</html>
