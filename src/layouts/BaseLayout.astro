---
import favicon from '../assets/projects/MW Favicon 800x800px Astro.png';
import '../styles/global.css';

const faviconAlt =
	'Bold cobalt-blue geometric monogram resembling connected capital M and W, centered on a plain white background; clean, modern, assertive design.';

interface Props {
	title?: string;
	description?: string;
	accentColor?: string;
}

const {
	title = 'Matthew — Frontend Developer & Designer',
	description = 'Frontend Developer & Designer specializing in Shopify storefronts, visual design, accessibility, and marketing websites.',
	accentColor,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="icon" type="image/png" href={favicon.src} title={faviconAlt} />
		<link rel="apple-touch-icon" href={favicon.src} title={faviconAlt} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body
		class:list={[accentColor && 'is-project']}
		style={
			accentColor
				? `--color-project: ${accentColor}; --color-accent: ${accentColor}; --color-focus: ${accentColor};`
				: undefined
		}
	>
		<a class="skip-link" href="#main">Skip to main content</a>
		<slot />
	</body>
</html>
