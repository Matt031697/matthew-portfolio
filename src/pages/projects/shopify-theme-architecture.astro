---
import { Image } from 'astro:assets';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { careerHighlights, projectAccents } from '../../lib/site.ts';
import { slugify } from '../../lib/strings.ts';
import responsiveByDefault from '../../assets/projects/shopify-theme/three-column-cards/responsive-by-default.png';
import flexiblePresentation from '../../assets/projects/shopify-theme/three-column-cards/flexible-presentation.png';
import businessConfiguration from '../../assets/projects/shopify-theme/three-column-cards/business-configuration.png';
import petRetailHeader from '../../assets/projects/shopify-theme/three-column-cards/pet-retail-header.png';
import rentalHeader from '../../assets/projects/shopify-theme/three-column-cards/rental-header.png';
import petInformationalHeader from '../../assets/projects/shopify-theme/three-column-cards/pet-informational-header.png';
import catalogBefore from '../../assets/projects/shopify-theme/two-column-cards/catalog-before.png';
import catalogAfter from '../../assets/projects/shopify-theme/two-column-cards/catalog-after.png';
import productDetailBefore from '../../assets/projects/shopify-theme/two-column-cards/product-detail-before.png';
import productDetailAfter from '../../assets/projects/shopify-theme/two-column-cards/product-detail-after.png';
import socialMediaBefore from '../../assets/projects/shopify-theme/two-column-cards/social-media-before.png';
import socialMediaAfter from '../../assets/projects/shopify-theme/two-column-cards/social-media-after.png';
import interiorPageBanner from '../../assets/projects/shopify-theme/two-column-cards/interior-page-banner.png';
import tileLayout from '../../assets/projects/shopify-theme/two-column-cards/tile-layout.png';
import imageBar from '../../assets/projects/shopify-theme/two-column-cards/image-bar.png';
import ctaBanner from '../../assets/projects/shopify-theme/two-column-cards/cta-banner.png';

const pageTitle = 'Shopify theme architecture, Matthew';
const description =
	'Case study: one shared Shopify theme for hundreds of storefronts. Layouts, components, updates, and support that each retailer inherits.';

const themeColumns = [
	{
		groups: [
			{
				label: 'Foundation',
				items: ['Theme structure', 'Configuration', 'Global settings'],
			},
		],
	},
	{
		groups: [
			{
				label: 'Reusable UI',
				items: ['Sections', 'Components', 'Shared patterns'],
			},
			{ label: 'App integrations' },
			{ label: 'Client storefronts' },
		],
	},
	{
		groups: [
			{
				label: 'Front-end development',
				items: ['Liquid', 'CSS', 'JavaScript'],
			},
		],
	},
];

const headerExamples = [
	{
		label: 'Pet retail header',
		image: petRetailHeader,
		alt: 'Animalia pet store homepage with a blue welcome banner, dog mascot, and departments for furry, feathery, and scaly pets.',
	},
	{
		label: 'Rental header',
		image: rentalHeader,
		alt: 'Website homepage for Northern Lakes True Value, showing the store entrance, “Welcome to” banner, navigation menu, search bar, and rental buttons.',
	},
	{
		label: 'Pet informational header',
		image: petInformationalHeader,
		alt: 'Pet & Aquarium website homepage showing the Claremont Pet Center storefront, with cat-ear graphics, blue-and-orange navigation, and catalog buttons.',
	},
];

const foundationFeatures = [
	{
		label: 'Responsive by default',
		image: responsiveByDefault,
		alt: 'Screenshot of Arey Building Supply website featuring a bright unfinished home interior, staircase, maroon navigation, search bar, and catalog button.',
		copy: 'Same hero structure. Different photos, copy, and screen sizes. I do not rebuild it for each store.',
	},
	{
		label: 'Flexible presentation',
		image: flexiblePresentation,
		alt: 'E-commerce webpage featuring project supplies, pet departments for furry, feathered and scaly animals, plus dog and cat essentials.',
		copy: 'Shared components change layout and styling to fit the storefront. The underlying piece stays the same.',
	},
	{
		label: 'Business specific configuration',
		image: businessConfiguration,
		alt: 'Farm cattle product listing page showing livestock medicines, fly sprays, leather whitener, and grooming products with prices and brand filters.',
		copy: 'Settings can show or hide behavior per business. One store can show a price range. Another uses the same component without it.',
	},
];

const uiImprovements = [
	{
		category: 'Catalog',
		before: {
			image: catalogBefore,
			alt: 'Lawn and garden shopping page showing colorful flower pots and planters in white, blue, orange, green, and black, with prices and filters.',
			copy: 'The catalog lacked structure and visual hierarchy, and it had no responsive CTAs. It looked unfinished, and that was not up to standard for a flagship product.',
		},
		after: {
			image: catalogAfter,
			alt: 'Lawn and garden shopping page showing colorful flower pots and planters in a product grid, with filters for price, brand, and categories.',
			copy: 'I gave it a hierarchy you can scan: consistent spacing, clearer type, and a hover that can say Add to Cart, More Info, or Request Availability depending on the catalog type.',
		},
	},
	{
		category: 'Product detail pages',
		before: {
			image: productDetailBefore,
			alt: 'Online store page showing a gray men’s hooded fleece jacket, price and add-to-cart button, plus recommended winter clothing and emergency ponchos.',
			copy: 'The product pages looked heavy and uneven once a description got long. Half the screen was blank, and the recommended products had no visual hierarchy or responsive CTAs.',
		},
		after: {
			image: productDetailAfter,
			alt: 'Online store page showing a gray hooded fleece jacket for men, priced at $35, with product details, add-to-cart button, and related items.',
			copy: 'I moved the details underneath the CTAs and the important information so the page has rhythm and fills that leftover space. Recommended products got their own cards, with hierarchy through type and color, and the same responsive CTAs as the catalog.',
		},
	},
	{
		category: 'Social media',
		before: {
			image: socialMediaBefore,
			alt: 'Website page screenshot featuring a craftsman working with wood, Facebook promotion, newsletter signup, service links, and blog articles.',
			copy: 'The existing component required a custom HTML block, meaning social media links had to be added and styled manually with HTML and CSS. This created unnecessary friction for team members who were not comfortable working with code.',
		},
		after: {
			image: socialMediaAfter,
			alt: 'Website screenshot featuring a contact form, happy dog in greenery, social media icons, and portraits of friendly store staff.',
			copy: 'I replaced the custom HTML block with theme settings. The team can control the heading, text, icons, spacing, and size without writing extra HTML or CSS.',
		},
	},
];

const reusableComponents = [
	{
		label: 'Interior page banner',
		image: interiorPageBanner,
		alt: 'Pet supply website banner featuring dog, cat, small animal, and fish products, plus a kitten being fed and a blue holiday promotion.',
		copy: 'Same banner component. Content, image, alignment, color, CTA, and size change to fit the page.',
	},
	{
		label: 'Tile layout',
		image: tileLayout,
		alt: 'Equipment rental website showing contractor, DIY, home/business, and landscaping rental tiles with tools, boxes, and outdoor machinery.',
		copy: 'Image or color tiles, overlays, CTAs, and up to seven tiles. One layout, different rental and retail uses.',
	},
	{
		label: 'Image bar',
		image: imageBar,
		alt: 'Pet supply webpage featuring trusted brand logos above three dogs labeled Grooming, In-Store Pickup, and Delivery, with a newsletter signup.',
		copy: 'Height, overlay, alignment, and linked text for a simple promo or content strip.',
	},
	{
		label: 'CTA banner',
		image: ctaBanner,
		alt: 'Website footer showing “Stay Connected” with social media icons above a bright blue pet-themed banner offering “Shop Now” and “Find a Location” buttons.',
		copy: 'Up to two buttons, background and banner size, text placement. Same component, different promotions.',
	},
];

const accessibilityItems = [
	{
		label: 'Keyboard navigation and focus',
		copy: 'Skip links, focus states, keyboard interactions, and focus management across navigation, drawers, dialogs, and shared components.',
	},
	{
		label: 'Accessible components',
		copy: 'Semantic markup, ARIA states, and screen-reader-friendly patterns across search, filters, carousels, product interfaces, and forms.',
	},
	{
		label: 'Shared improvements',
		copy: 'Accessibility and performance fixes built into the theme so one improvement can benefit every storefront that follows. See the dedicated accessibility audits case study for audit workflow and examples.',
	},
];

const closingBadges = [
	'Shopify',
	'Liquid',
	'JavaScript',
	'CSS',
	'Theme Architecture',
	'Reusable Components',
	'Accessibility',
	'UX/UI',
];

---

<BaseLayout title={pageTitle} {description} accentColor={projectAccents.shopify}>
	<Header backToProjects />

	<main id="main">
		<div class="section-group section-group--intro">
			<div class="container">
				<section class="hero hero--project" aria-labelledby="case-study-heading">
					<h1 id="case-study-heading">Shopify theme architecture</h1>
					<p class="hero__subheading">
						One shared Shopify theme applied to hundreds of clients. For each build I
						take ownership of layout, design, copy, app installs, and future updates.
						When something needs investigating or a custom solution, I assess it and
						implement it under my roof, and that work goes back into the theme.
					</p>
					<ul class="badge-list hero__badges">
						<li class="badge">
							<span class="badge__full">{careerHighlights.experience}</span>
							<span class="badge__compact">{careerHighlights.experienceCompact}</span>
						</li>
						<li class="badge">
							<span class="badge__full">{careerHighlights.storefronts}</span>
							<span class="badge__compact">{careerHighlights.storefrontsCompact}</span>
						</li>
						<li class="badge">
							<span class="badge__full">{careerHighlights.releases}</span>
							<span class="badge__compact">{careerHighlights.releasesCompact}</span>
						</li>
					</ul>
					<a
						class="btn hero__cta"
						href="https://kirchnerbuildingcenters.com/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="View Kirchner Building Centers live site (opens in a new tab)"
					>
						View Live Site
					</a>
				</section>
			</div>
		</div>

		<div class="section-group">
			<section class="section-block" aria-labelledby="case-study-context-heading">
				<div class="container">
					<div class="heading-block">
						<h2 id="case-study-context-heading">The work</h2>
						<div class="content-copy content-copy--narrow">
							<p>
								The task is simple to say and hard to achieve. Every store needs its
								own voice, its own branding, its own identity, but it still has to live
								under one theme. I solve that with shared pieces and per-store
								settings, then I check the work before it ships.
							</p>
						</div>
					</div>

					<div class="heading-block">
						<h2 id="header-showcase-heading">One header, different storefronts</h2>
						<p class="section-intro">
							Pet stores, garden centers, hardware, rental, and retail. Same theme,
							different branding and settings.
						</p>
					</div>

					<div class="showcase-grid">
					{
						headerExamples.map((example) => (
							<figure class="showcase-item" aria-labelledby={`header-${slugify(example.label)}`}>
								<figcaption
									id={`header-${slugify(example.label)}`}
									class="text-accent section-label showcase-item__label"
								>
									{example.label}
								</figcaption>
								{
									example.image ? (
										<Image
											class="showcase-item__media"
											src={example.image}
											alt={example.alt ?? example.label}
											widths={[640, 960, 1280]}
											sizes="(min-width: 48rem) 30vw, 92vw"
										/>
									) : (
										<div class="media-placeholder" aria-hidden="true" />
									)
								}
							</figure>
						))
					}
				</div>
			</div>
		</section>

		<section class="section-block" aria-labelledby="ui-improvements-heading">
			<div class="container">
				<div class="heading-block">
					<h2 id="ui-improvements-heading">UI/UX improvements</h2>
					<p class="section-intro">
						Before-and-after work inside the shared theme: clearer hierarchy and
						interaction, without a new system each time.
					</p>
				</div>

				<p id="ui-improvements-eyebrow" class="text-accent section-label">Before / after</p>

				<div class="before-after-list" role="group" aria-labelledby="ui-improvements-eyebrow">
					{
						uiImprovements.map((example) => (
							<section
								class="before-after-block"
								aria-labelledby={`before-after-${slugify(example.category)}`}
							>
								<h3
									id={`before-after-${slugify(example.category)}`}
									class="subsection-title"
								>
									{example.category}
								</h3>

								<div class="before-after-grid">
									<article class="before-after-item" aria-labelledby={`${slugify(example.category)}-before`}>
										{
											example.before.image ? (
												<Image
													class="before-after-item__media"
													src={example.before.image}
													alt={example.before.alt ?? `${example.category} before`}
													widths={[640, 960, 1280, 1920]}
													sizes="(min-width: 48rem) 46vw, 92vw"
												/>
											) : (
												<div class="media-placeholder" aria-hidden="true" />
											)
										}
										<div class="heading-block">
											<h4 id={`${slugify(example.category)}-before`} class="text-accent section-label">
												Before
											</h4>
											<p class="before-after-item__copy">{example.before.copy}</p>
										</div>
									</article>

									<article class="before-after-item" aria-labelledby={`${slugify(example.category)}-after`}>
										{
											example.after.image ? (
												<Image
													class="before-after-item__media"
													src={example.after.image}
													alt={example.after.alt ?? `${example.category} after`}
													widths={[640, 960, 1280, 1920]}
													sizes="(min-width: 48rem) 46vw, 92vw"
												/>
											) : (
												<div class="media-placeholder" aria-hidden="true" />
											)
										}
										<div class="heading-block">
											<h4 id={`${slugify(example.category)}-after`} class="text-accent section-label">
												After
											</h4>
											<p class="before-after-item__copy">{example.after.copy}</p>
										</div>
									</article>
								</div>
							</section>
						))
					}
				</div>
			</div>
		</section>

		<section class="section-block" aria-labelledby="building-blocks-heading">
			<div class="container">
				<div class="heading-block">
					<h2 id="building-blocks-heading">Building blocks</h2>
					<p class="section-intro">
						Global styles and per-store settings, plus Liquid, CSS, and JavaScript
						built once and adapted per storefront.
					</p>
				</div>

				<div class="showcase-grid">
					{
						foundationFeatures.map((feature) => (
							<article
								class="showcase-item showcase-item--feature"
								aria-labelledby={`foundation-${slugify(feature.label)}`}
							>
								{
									feature.image ? (
										<Image
											class="showcase-item__media"
											src={feature.image}
											alt={feature.alt ?? feature.label}
											widths={[640, 960, 1280]}
											sizes="(min-width: 48rem) 30vw, 92vw"
										/>
									) : (
										<div class="media-placeholder" aria-hidden="true" />
									)
								}
								<div class="heading-block">
									<h3
										id={`foundation-${slugify(feature.label)}`}
										class="text-accent section-label showcase-item__label"
									>
										{feature.label}
									</h3>
									<p class="showcase-item__copy">{feature.copy}</p>
								</div>
							</article>
						))
					}
				</div>

				<div class="heading-block">
					<h3 id="building-blocks-components" class="subsection-title">
						Reusable components
					</h3>
				</div>

				<div
					class="showcase-grid showcase-grid--2"
					role="group"
					aria-labelledby="building-blocks-components"
				>
					{
						reusableComponents.map((component) => (
							<article
								class="showcase-item showcase-item--feature"
								aria-labelledby={`component-${slugify(component.label)}`}
							>
								{
									component.image ? (
										<Image
											class="showcase-item__media"
											src={component.image}
											alt={component.alt ?? component.label}
											widths={[640, 960, 1280, 1920]}
											sizes="(min-width: 48rem) 46vw, 92vw"
										/>
									) : (
										<div class="media-placeholder" aria-hidden="true" />
									)
								}
								<div class="heading-block">
									<h4
										id={`component-${slugify(component.label)}`}
										class="text-accent section-label showcase-item__label"
									>
										{component.label}
									</h4>
									<p class="showcase-item__copy">{component.copy}</p>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="section-block" aria-labelledby="theme-structure-heading">
			<div class="container">
				<div class="heading-block">
					<h2 id="theme-structure-heading">How one theme scales</h2>
					<p class="section-intro">
						Components, patterns, and settings that can be assembled per storefront
						instead of a unique build each time.
					</p>
				</div>

				<div class="theme-diagram" role="group" aria-labelledby="theme-diagram-heading">
					<h3 id="theme-diagram-heading" class="subsection-title">Shared Shopify theme</h3>
					<div class="theme-grid">
						{
							themeColumns.map((column) => (
								<div class="theme-grid__column">
									{
										column.groups.map((group) => (
											<div class="theme-grid__group">
												<h4 class="text-accent theme-grid__label">{group.label}</h4>
												{
													group.items && group.items.length > 0 && (
														<ul class="theme-grid__list">
															{group.items.map((item) => (
																<li>{item}</li>
															))}
														</ul>
													)
												}
											</div>
										))
									}
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>
		<section class="section-block" aria-labelledby="accessibility-performance-heading">
			<div class="container">
				<div class="heading-block">
					<h2 id="accessibility-performance-heading">Accessibility and performance</h2>
					<div class="section-intro">
						<p>I build this into the components, not as a last-minute checklist.</p>
						<p>
							<a href="/projects/shopify-accessibility-audits">See the accessibility audits case study</a> for the audit workflow and examples.
						</p>
					</div>
				</div>

				<div class="content-list content-list--grid">
					{
						accessibilityItems.map((item) => (
							<section class="content-block" aria-labelledby={slugify(item.label)}>
								<h3 id={slugify(item.label)} class="text-accent section-label">
									{item.label}
								</h3>
								<p>{item.copy}</p>
							</section>
						))
					}
				</div>
			</div>
		</section>

		<section class="section-block" aria-labelledby="case-study-closing-heading">
			<div class="container">
				<div class="heading-block">
					<h2 id="case-study-closing-heading">The result</h2>
					<div class="content-copy content-copy--narrow">
						<p>
							Hundreds of updates, done so the naked eye can't tell the stores are
							part of a template. Layouts, settings, and components are shared so they
							fit many different use cases under one umbrella. That is how unique
							designs, enjoyable experiences, and results show up for retailers big or
							small.
						</p>
					</div>
				</div>
				<ul class="badge-list hero__badges">
					{closingBadges.map((badge) => <li class="badge">{badge}</li>)}
				</ul>
			</div>
		</section>
		</div>
	</main>

	<Footer />
</BaseLayout>
