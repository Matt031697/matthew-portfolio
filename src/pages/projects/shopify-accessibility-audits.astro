---
import { Image } from 'astro:assets';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { careerHighlights, projectAccents } from '../../lib/site.ts';
import waveAudit from '../../assets/projects/accessibility/wave-audit.png';
import lighthouseAccessibility from '../../assets/projects/accessibility/lighthouse-accessibility.png';
import skipToContent from '../../assets/projects/accessibility/skip-to-content.png';
import manualTesting from '../../assets/projects/accessibility/manual-testing.png';
import visibleFocus from '../../assets/projects/accessibility/visible-focus.png';
import dialogMenu from '../../assets/projects/accessibility/dialog-menu.png';
import accessibleNames from '../../assets/projects/accessibility/accessible-names.png';

const pageTitle = 'Shopify Accessibility Audits, Matthew';
const description =
	'I make sure every Shopify storefront is accessible before it ships. When a barrier lives in a shared component, I fix it in the theme so the next site inherits the work.';

const auditProcess = [
	{
		label: 'Scan',
		copy: 'WAVE and Lighthouse on the live site, before launch. I care about errors and contrast, not a performance score.',
	},
	{
		label: 'Investigate',
		copy: 'Is it the theme, a shared piece, the merchant’s content, or an app? That tells me if I fix this store or the whole system.',
	},
	{
		label: 'Test by hand',
		copy: 'I check it on real product, collection, and cart pages. The report is just a starting point.',
	},
	{
		label: 'Fix and recheck',
		copy: 'Fix this storefront, or put it in the theme if I know the next client is going to run into the same thing.',
	},
];

const auditTools = [
	{
		id: 'tool-wave',
		label: 'WAVE',
		image: waveAudit,
		alt: 'WAVE sidebar on the Northington Windows & Doors homepage reporting zero errors, zero contrast errors, and an AIM score of 10 out of 10.',
		copy: 'A first look at errors and contrast on the live page. Not the last word.',
	},
	{
		id: 'tool-lighthouse',
		label: 'Lighthouse',
		image: lighthouseAccessibility,
		alt: 'Lighthouse Accessibility report with a score of 100, listing items to check by hand beside 31 passed automated audits.',
		copy: 'A second look. I read the accessibility findings and skip the performance pane.',
	},
	{
		id: 'tool-manual-testing',
		label: 'Manual testing',
		image: manualTesting,
		alt: 'Northington Windows & Doors homepage with heading-level overlays on the hero and Explore the line section.',
		copy: 'Then I go through headings, contrast, names, and keyboard on the pages people actually use.',
	},
];

const themeEvidence = [
	{
		id: 'evidence-skip',
		label: 'Skip to content',
		image: skipToContent,
		alt: 'Northington Windows & Doors homepage with a visible Skip to content control in the top left, navigation, and a suburban home beside the headline.',
		copy: 'It stays out of the way until you tab to it, then you can skip the header and get to the page.',
	},
	{
		id: 'evidence-focus',
		label: 'Visible focus',
		image: visibleFocus,
		alt: 'Northington Windows & Doors homepage with a visible focus ring around the Call us button in the header, beside Find a Location.',
		copy: 'Call us has a ring around it when you tab there. I don’t ship a button you can’t see. That outline lives in the theme.',
	},
	{
		id: 'evidence-dialog',
		label: 'Dialogs',
		image: dialogMenu,
		alt: 'Mobile Northington website screenshot with navigation menu open, showing links for windows, doors, locations, resources, contact, and location search.',
		copy: 'Opening the menu shouldn’t dump you onto the page behind it. Focus stays inside until you’re ready to close it.',
	},
	{
		id: 'evidence-names',
		label: 'Accessible names',
		image: accessibleNames,
		alt: 'Northington Windows website screenshot showing “Windows & doors that work as hard as you do” beside a modern house; accessibility inspector open.',
		copy: 'A Facebook icon with no name is just an empty button. I want the inspector to see Facebook, Close menu, Next.',
	},
];

const shippedGroups = [
	{
		id: 'shipped-site-wide',
		label: 'Site-wide',
		items: ['Skip to content', 'Visible focus', 'Reduced motion', 'Named social links', 'Pagination'],
	},
	{
		id: 'shipped-header',
		label: 'Header and menu',
		items: ['Mobile menu as a dialog', 'Labeled close control', 'Announced search suggestions', 'Labeled contact icons'],
	},
	{
		id: 'shipped-catalog',
		label: 'Catalog',
		items: ['Filter open/closed state', 'Filter drawer as a dialog', 'Screen-reader-friendly prices', 'Missing-image text', 'Labeled sort'],
	},
	{
		id: 'shipped-product',
		label: 'Product',
		items: ['Lightbox as a dialog', 'Zoom ignored by assistive tech', 'Labeled carousel controls'],
	},
	{
		id: 'shipped-cart',
		label: 'Cart and rental',
		items: ['Labeled flyouts', 'Keyboard rental options', 'Labeled remove actions'],
	},
	{
		id: 'shipped-content-forms',
		label: 'Content and forms',
		items: ['Native FAQ accordion', 'Captioned data tables', 'Real form labels'],
	},
];

const closingBadges = ['WCAG 2.1', 'Manual Testing', 'Shared theme'];
---

<BaseLayout title={pageTitle} {description} accentColor={projectAccents.audits}>
	<Header backToProjects />

	<main id="main">
		<div class="section-group section-group--intro">
			<div class="container">
				<section class="hero hero--project" aria-labelledby="case-study-heading">
					<h1 id="case-study-heading">Shopify Accessibility Audits</h1>
					<p class="hero__subheading">
						I make sure every storefront is accessible. Digital shouldn’t be exclusive.
						Assessments, quality checks, and changes all happen before something ships.
						When the barrier lives in a shared component, I fix it in the theme so the
						next site inherits the work.
					</p>
					<ul class="badge-list hero__badges">
						<li class="badge">WCAG 2.1</li>
						<li class="badge">WAVE</li>
						<li class="badge">Lighthouse</li>
						<li class="badge">{careerHighlights.storefronts}</li>
					</ul>
					<a
						class="btn hero__cta"
						href="https://kirchnerbuildingcenters.com/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="View Kirchner Building Centers live site (opens in a new tab)"
					>
						View Live Site
					</a>
				</section>
			</div>
		</div>

		<div class="section-group">
			<section class="section-block" aria-labelledby="case-study-context-heading">
				<div class="container">
					<div class="heading-block">
						<h2 id="case-study-context-heading">The work</h2>
						<div class="content-copy content-copy--narrow">
							<p>
								One audit is never the same as the next. Mixed code, different components,
								branding assets, colors, apps, content, the list goes on. That’s what
								keeps the work interesting, and that’s why I keep my eyes open: find what
								blocks people, fix it, and ship it. If a barrier becomes consistent, the
								update goes in the{' '}
								<a href="/projects/shopify-theme-architecture">shared theme</a>.
							</p>
						</div>
					</div>

					<div class="heading-block">
						<p class="text-accent section-label">When it belongs in the theme</p>
						<h2 id="shipped-heading">One fix, every storefront</h2>
						<p class="section-intro">
							A menu, a missing name, a drawer that only works with a mouse. If it fails for
							one client, it will fail for the next. I put those fixes in the shared Shopify
							theme so the storefront still looks like itself. Skip, focus, menus, and names
							are what that looks like on a live page.
						</p>
					</div>

					<div class="showcase-grid showcase-grid--2">
						{
							themeEvidence.map((shot) => (
								<article
									class="showcase-item showcase-item--feature"
									aria-labelledby={shot.id}
								>
									{
										shot.image ? (
											<Image
												class="showcase-item__media"
												src={shot.image}
												alt={shot.alt ?? shot.label}
												widths={[640, 960, 1280, 1920]}
												sizes="(min-width: 48rem) 46vw, 92vw"
											/>
										) : (
											<div class="media-placeholder" aria-hidden="true" />
										)
									}
									<div class="heading-block">
										<h3
											id={shot.id}
											class="text-accent section-label showcase-item__label"
										>
											{shot.label}
										</h3>
										<p class="showcase-item__copy">{shot.copy}</p>
									</div>
								</article>
							))
						}
					</div>

					<section class="coverage-block" aria-labelledby="shipped-changelog-heading">
						<div class="heading-block">
							<p class="text-accent section-label">What has shipped</p>
							<h3 id="shipped-changelog-heading" class="subsection-title">
								Across the theme
							</h3>
						</div>

						<div class="shipped-grid">
							{
								shippedGroups.map((group) => (
									<section class="shipped-card" aria-labelledby={group.id}>
										<h4 id={group.id} class="text-accent section-label">
											{group.label}
										</h4>
										<ul>
											{group.items.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</section>
								))
							}
						</div>
					</section>
				</div>
			</section>

			<section class="section-block" aria-labelledby="audit-process-heading">
				<div class="container">
					<div class="heading-block">
						<p class="text-accent section-label">The process</p>
						<h2 id="audit-process-heading">Before a storefront goes live</h2>
						<p class="section-intro">
							Scan, check what’s real, fix it, and look again. All of that before it ships,
							not after.
						</p>
					</div>

					<ol class="pipeline" aria-label="Audit process">
						{
							auditProcess.map((step) => (
								<li class="pipeline__item">
									<h3 class="text-accent pipeline__label">{step.label}</h3>
									<p>{step.copy}</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<section class="section-block" aria-labelledby="audit-tools-heading">
				<div class="container">
					<div class="heading-block">
						<p class="text-accent section-label">What I use</p>
						<h2 id="audit-tools-heading">The scan, then the storefront</h2>
						<p class="section-intro">
							Northington Windows &amp; Doors is a recent live site I ran through the same
							checks. The tools point me at issues. I still decide what actually ships.
						</p>
					</div>

					<div class="showcase-grid showcase-grid--3">
						{
							auditTools.map((tool) => (
								<article
									class="showcase-item showcase-item--feature"
									aria-labelledby={tool.id}
								>
									{
										tool.image ? (
											<Image
												class="showcase-item__media"
												src={tool.image}
												alt={tool.alt ?? tool.label}
												widths={[640, 960, 1280, 1920]}
												sizes="(min-width: 64rem) 30vw, 92vw"
											/>
										) : (
											<div class="media-placeholder" aria-hidden="true" />
										)
									}
									<div class="heading-block">
										<h3
											id={tool.id}
											class="text-accent section-label showcase-item__label"
										>
											{tool.label}
										</h3>
										<p class="showcase-item__copy">{tool.copy}</p>
									</div>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section class="section-block" aria-labelledby="case-study-closing-heading">
				<div class="container">
					<div class="heading-block">
						<h2 id="case-study-closing-heading">The result</h2>
						<div class="content-copy content-copy--narrow">
							<p>
								Every storefront gets the check before it ships. The report starts it. The
								fix finishes it, on that store or in the theme, so the next one doesn’t
								inherit the barrier.
							</p>
						</div>
					</div>

					<ul class="badge-list hero__badges">
						{closingBadges.map((badge) => <li class="badge">{badge}</li>)}
					</ul>
				</div>
			</section>
		</div>
	</main>

	<Footer />
</BaseLayout>

<style>
	@media (min-width: 48rem) {
		.pipeline {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.pipeline {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
