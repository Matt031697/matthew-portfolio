---
import { Image } from 'astro:assets';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectAccents } from '../../lib/site.ts';
import { slugify } from '../../lib/strings.ts';
import petXtrasHomepage from '../../assets/projects/ai-websites/pet-xtras-homepage.png';
import oberstsHomepage from '../../assets/projects/ai-websites/obersts-homepage.png';
import northingtonHomepage from '../../assets/projects/ai-websites/northington-homepage.png';
import petXtrasDevices from '../../assets/projects/ai-websites/pet-xtras-devices.png';
import oberstsDevices from '../../assets/projects/ai-websites/obersts-devices.png';
import northingtonDevices from '../../assets/projects/ai-websites/northington-devices.png';

const pageTitle = 'AI-Assisted Websites, Matthew';
const description =
	'I use AI-assisted development to rapidly design and build lightweight, production-ready websites, while remaining responsible for architecture, design, accessibility, performance, and final quality.';

const workflowSteps = [
	{
		label: 'Foundation',
		copy: 'Shared Astro packages, GitHub store repo, Cloudflare hosting, and category-specific prompts. Every project starts from the same production-ready baseline.',
	},
	{
		label: 'AI-assisted build',
		copy: 'Cursor customizes layout, components, brand tokens, and content around the business. A pet store, grooming salon, and windows line do not share the same design prompt.',
	},
	{
		label: 'Review and refine',
		copy: 'I read every generated change. What drifts from brand, accessibility, or scope gets rejected or rewritten. Images migrate to the CDN; typecheck, build, and responsive testing run before anything ships.',
	},
];

const cursorUses = [
	{
		label: 'Design direction and scaffolding',
		copy: 'Category prompts set tone before layout exists. Cursor stands up homepage flow, offering pages, components, and routes from the MightyLocal template stack.',
	},
	{
		label: 'Content and patterns',
		copy: 'Business inputs become benefit-led copy, offerings files, and repeated production patterns like accessibility statements, contact forms, and favicons, faster than rebuilding by hand.',
	},
	{
		label: 'Iteration, not one shot',
		copy: 'Useful work happens across multiple rounds. I generate, review, adjust the prompt or code, and generate again. The first pass is a starting point.',
	},
];

const humanDirection = [
	{
		label: 'Design and UX',
		copy: 'How much brand color to use, which sections need photography, where whitespace stays tight, and how phone, hours, and location stay obvious on a companion site.',
	},
	{
		label: 'Architecture',
		copy: 'When to keep a MightyLocal route, when to override it, how live location data shows in the header, and what belongs in a custom component versus the shared theme.',
	},
	{
		label: 'Quality and content',
		copy: 'Skip links, heading order, contrast, touch targets, and real 404s. Short, local copy that belongs on the site, not filler, repeated photos, or catalog features the business did not ask for.',
	},
];

const deployStages = [
	{
		label: 'Astro',
		copy: 'Local preview, type checking, and a production build against the MightyLocal Astro stack.',
	},
	{
		label: 'GitHub',
		copy: 'The store repository is the source of truth. A commit and push trigger the Deploy Astro Site Worker workflow.',
	},
	{
		label: 'Cloudflare Workers',
		copy: 'The site runs as an Astro SSR Worker and goes live on a mightylocal.dev URL.',
	},
	{
		label: 'CDN',
		copy: 'Images upload to Cloudflare. Local image paths are rewritten to CDN URLs so the repo stays lean and assets load globally.',
	},
];

const qualityChecks = [
	{
		label: 'Build gate',
		copy: 'Typecheck and a clean production build before anything ships. Generated code that does not compile does not deploy.',
	},
	{
		label: 'Accessibility and responsive',
		copy: 'Skip link, semantics, keyboard use, contrast, contact form protection, favicon, 404, and accessibility statement, checked in the browser, not only in markup.',
	},
	{
		label: 'Source and assets',
		copy: 'Images verified, uploaded to the CDN, and rewritten in source. Scope creep, leftover local paths, and missing alt text get caught before the site goes live.',
	},
];

const liveSites = [
	{
		name: "Oberst's Pet Paradise",
		slug: 'obersts-pet-paradise',
		location: 'Ford City, PA',
		href: 'https://obersts-pet-paradise-pa.mightylocal.dev/',
		copy: 'A specialty pet store organized around eight departments. Aquatic leads as the signature offering; the rest stay scannable so visitors can find fish, reptiles, birds, and small animals without a catalog-style layout.',
		image: oberstsDevices,
		alt: 'Responsive exotic pet care website displayed on desktop, laptop, and smartphone, featuring veterinary departments and a friendly parrot; welcoming tone.',
	},
	{
		name: 'Pet Xtras Grooming',
		slug: 'pet-xtras-grooming',
		location: 'Howell, MI',
		href: 'https://pet-xtras-mi.mightylocal.dev/',
		copy: 'A grooming salon that uses the about page to build trust: People\'s Choice recognition, natural products, and wellness checks. The story does the selling so the site stays a companion, not a booking engine.',
		image: petXtrasDevices,
		alt: 'Responsive pet grooming website displayed on a desktop monitor, laptop, and smartphone, showcasing services, testimonials, and a clean modern layout.',
	},
	{
		name: 'Northington Windows & Doors',
		slug: 'northington-windows-doors',
		location: 'CT & MA',
		href: 'https://northington-windows-doors.mightylocal.dev/',
		copy: 'A private-label windows and doors line for builders and homeowners across five showrooms. Budget-friendly positioning, clear product paths, and a contact-first layout instead of a catalog.',
		image: northingtonDevices,
		alt: 'Responsive home-improvement website displayed on a desktop, laptop, and smartphone, featuring entry, patio, storm, and interior doors.',
	},
];

const learnedItems = [
	{
		label: 'What AI is genuinely good at',
		copy: 'Scaffolding a site from a detailed prompt, repeating component patterns, drafting first-pass layout and CSS tokens, and moving through boilerplate much faster than starting from a blank file. Given a strong foundation and a specific brief, it gets to a working website quickly.',
	},
	{
		label: 'Where it struggles',
		copy: 'Restraint. Left alone it adds extra navigation, saturated brand blocks, repeated photos, and features the business does not need. It also misses framework boundaries which MightyLocal routes to keep, which widgets belong, and when a marketing site is starting to look like a catalog.',
	},
	{
		label: 'Where expertise matters',
		copy: 'Writing the prompts, choosing the architecture, judging the design, rewriting the content, and deciding when the site is actually done. The workflow only holds if someone who knows the stack and the standard reviews every pass before it moves forward.',
	},
];

const resultBadges = [
	'Cursor',
	'MightyLocal',
	'Accessibility',
	'AI-Assisted Development',
];

const featuredLiveSite =
	liveSites.find((site) => site.slug === 'northington-windows-doors') ?? liveSites[0];

const workflowMockups = [
	{
		image: oberstsHomepage,
		alt: 'Exotic pet store website homepage featuring a yellow bird, clownfish, hamster, and tortoise; welcoming text promotes local pet care.',
	},
	{
		image: petXtrasHomepage,
		alt: 'Pet Extras grooming website homepage showing a fluffy golden dog being groomed, with booking information and a friendly, professional tone.',
	},
	{
		image: northingtonHomepage,
		alt: 'Website homepage for Northington Window Works featuring a welcoming home exterior, bold “Windows & doors that work as hard as you,” and service stats.',
	},
];
---

<BaseLayout title={pageTitle} {description} accentColor={projectAccents.astro}>
	<Header backToProjects />

	<main id="main">
		<div class="section-group section-group--intro">
			<div class="container">
				<section class="hero hero--project" aria-labelledby="case-study-heading">
					<h1 id="case-study-heading">AI-Assisted Websites</h1>
					<p class="hero__subheading">
						Three live companion sites for local businesses, built with Cursor on a shared Astro
						foundation. AI speeds up implementation; I own design, architecture, accessibility,
						and what ships.
					</p>
					<ul class="badge-list hero__badges">
						<li class="badge">Cursor</li>
						<li class="badge">MightyLocal</li>
						<li class="badge">Accessibility</li>
						<li class="badge">AI-Assisted Development</li>
					</ul>
					<a
						class="btn hero__cta"
						href={featuredLiveSite.href}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`View live site: ${featuredLiveSite.name} (opens in a new tab)`}
					>
						View Live Site
					</a>
				</section>
			</div>
		</div>

		<div class="section-group">
			<section class="section-block" aria-labelledby="applications-heading">
				<div class="container">
					<div class="heading-block">
						<h2 id="applications-heading">Three live businesses</h2>
						<p class="section-intro">
							Same foundation, same workflow, different stores. Each built to feel like it
							belongs to that business, not a template.
						</p>
					</div>

					<div class="showcase-grid">
						{
							liveSites.map((site) => (
								<article
									class="showcase-item showcase-item--feature"
									aria-labelledby={`site-${site.slug}`}
								>
									{
										site.image ? (
											<Image
												class="showcase-item__media"
												src={site.image}
												alt={site.alt ?? site.name}
												widths={[640, 960, 1280]}
												sizes="(min-width: 48rem) 30vw, 92vw"
											/>
										) : (
											<div class="media-placeholder media-placeholder--compact" aria-hidden="true" />
										)
									}
									<div class="heading-block">
										<p class="text-accent section-label">{site.location}</p>
										<h3 id={`site-${site.slug}`} class="subsection-title">
											{site.name}
										</h3>
										<p class="showcase-item__copy">{site.copy}</p>
										<a
											class="btn"
											href={site.href}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`View live site: ${site.name} (opens in a new tab)`}
										>
											View Live Site
										</a>
									</div>
								</article>
							))
						}
					</div>

					<div class="heading-block">
						<h2 id="case-study-context-heading">The work</h2>
						<div class="content-copy content-copy--narrow">
							<p>
								MightyLocal companion sites for local retailers, polished, lightweight, and
								tailored around each business, its customers, and its market. I use Cursor on a
								shared Astro foundation to move fast without sacrificing production standards.
							</p>
							<p>
								The challenge is repeatable speed with real customization: a process that scales
								across stores while each site still feels specific, with a review loop that keeps
								AI output from drifting past scope.
							</p>
						</div>
					</div>

					<div class="media-row media-row--3" role="group" aria-label="Companion site homepages">
						{
							workflowMockups.map((mockup) => (
								<Image
									class="showcase-item__media"
									src={mockup.image}
									alt={mockup.alt}
									widths={[640, 960, 1280]}
									sizes="(min-width: 48rem) 30vw, 92vw"
								/>
							))
						}
					</div>
				</div>
			</section>

			<section class="section-block" aria-labelledby="workflow-heading">
				<div class="container">
					<div class="content-grid content-grid--center">
						<div class="content-grid__column">
							<div class="heading-block">
								<h2 id="workflow-heading">How companion sites get built</h2>
								<p class="section-intro">
									Shared infrastructure and category prompts make the work repeatable. Review
									and refinement keep each site specific to the business.
								</p>
							</div>

							{
								workflowSteps.map((step) => (
									<section class="content-block" aria-labelledby={`workflow-${slugify(step.label)}`}>
										<h3 id={`workflow-${slugify(step.label)}`} class="section-label">
											{step.label}
										</h3>
										<p>{step.copy}</p>
									</section>
								))
							}
						</div>

						<div class="content-grid__column">
							<div class="heading-block">
								<h2 id="local-to-live-heading">From local to live</h2>
								<p class="section-intro">
									Astro preview → GitHub → Cloudflare Workers → CDN. No separate hosting stack
									per store.
								</p>
							</div>

							<ol class="pipeline" aria-label="Deployment path">
								{
									deployStages.map((stage) => (
										<li class="pipeline__item">
											<h3 class="text-accent pipeline__label">{stage.label}</h3>
											<p>{stage.copy}</p>
										</li>
									))
								}
							</ol>
						</div>
					</div>
				</div>
			</section>
		</div>

		<div class="section-group">
			<section class="section-block" aria-labelledby="ai-partner-heading">
				<div class="container">
					<div class="content-grid content-grid--center">
						<div class="content-grid__column">
							<div class="heading-block">
								<h2 id="ai-partner-heading">What Cursor handles</h2>
								<p class="section-intro">
									Implementation speed, not architecture, and not a finished site on the first
									pass.
								</p>
							</div>

							{
								cursorUses.map((item) => (
									<section class="content-block" aria-labelledby={`cursor-${slugify(item.label)}`}>
										<h3 id={`cursor-${slugify(item.label)}`} class="section-label">
											{item.label}
										</h3>
										<p>{item.copy}</p>
									</section>
								))
							}
						</div>

						<div class="content-grid__column">
							<div class="heading-block">
								<h2 id="human-direction-heading">What stays human</h2>
								<p class="section-intro">
									AI can generate a working page in minutes. It cannot decide whether that page
									is the right page.
								</p>
							</div>

							{
								humanDirection.map((item) => (
									<section class="content-block" aria-labelledby={`direction-${slugify(item.label)}`}>
										<h3 id={`direction-${slugify(item.label)}`} class="section-label">
											{item.label}
										</h3>
										<p>{item.copy}</p>
									</section>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section class="section-block" aria-labelledby="quality-heading">
				<div class="container">
					<div class="heading-block">
						<h2 id="quality-heading">Before it ships</h2>
						<p class="section-intro">
							Speed only holds if the site still typechecks, builds, stays accessible, and
							survives a source review.
						</p>
					</div>

					<div class="content-list content-list--grid content-list--3">
						{
							qualityChecks.map((item) => (
								<section class="content-block" aria-labelledby={`quality-${slugify(item.label)}`}>
									<h3 id={`quality-${slugify(item.label)}`} class="text-accent section-label">
										{item.label}
									</h3>
									<p>{item.copy}</p>
								</section>
							))
						}
					</div>
				</div>
			</section>
		</div>

		<div class="section-group">
			<section class="section-block" aria-labelledby="case-study-closing-heading">
				<div class="container">
					<div class="heading-block">
						<h2 id="case-study-closing-heading">The result</h2>
						<div class="content-copy content-copy--narrow">
							<p>
								Three live companion sites, each tailored to the business, built on the same
								Astro foundation, and held to the same production standard. AI accelerates
								implementation; judgment on design, architecture, accessibility, and scope stays
								human.
							</p>
						</div>
					</div>

					<div class="content-list content-list--grid content-list--3">
						{
							learnedItems.map((item) => (
								<section class="content-block" aria-labelledby={`learned-${slugify(item.label)}`}>
									<h3 id={`learned-${slugify(item.label)}`} class="text-accent section-label">
										{item.label}
									</h3>
									<p>{item.copy}</p>
								</section>
							))
						}
					</div>

					<ul class="badge-list hero__badges">
						{resultBadges.map((badge) => <li class="badge">{badge}</li>)}
					</ul>
				</div>
			</section>
		</div>
	</main>

	<Footer />
</BaseLayout>
