---
import AboutSection from '../components/AboutSection.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PhilosophySection from '../components/PhilosophySection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { careerHighlights, projectAccents } from '../lib/site.ts';
---

<BaseLayout
	accentColor={projectAccents.home}
	title="Matthew, Designer & Front-end Developer"
	description="Designer and front-end developer. Brands, campaigns, and Shopify storefronts for retailers and local businesses."
>
	<Header />

	<main id="main">
		<div class="container">
			<section class="hero hero--home" aria-labelledby="hero-heading">
				<p class="text-accent section-label hero__eyebrow">Hi, I'm Matthew</p>
				<h1 id="hero-heading">Designer &amp; Front-end Developer.</h1>
				<p class="hero__subheading">
					I design brands, campaigns, and storefronts for retailers and local
					businesses, then build them to hold up in production.
				</p>
				<ul class="badge-list hero__badges">
					<li class="badge">{careerHighlights.experience}</li>
					<li class="badge">{careerHighlights.storefronts}</li>
					<li class="badge">{careerHighlights.releases}</li>
				</ul>
			</section>
		</div>

		<div class="section-group">
			<PhilosophySection />
			<AboutSection />
		</div>
	</main>

	<Footer />
</BaseLayout>

<style>
	.hero--home {
		padding-block-end: 0;
	}
</style>
