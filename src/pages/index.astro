---
import AboutSection from '../components/AboutSection.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PhilosophySection from '../components/PhilosophySection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { careerHighlights, projectAccents } from '../lib/site.ts';
---

<BaseLayout
	accentColor={projectAccents.home}
	title="Matthew, Designer & Front-end Developer"
	description="Designer and front-end developer. Shopify storefronts, marketing assets, shared components, and technical support for retailers."
>
	<Header />

	<main id="main">
		<div class="container">
			<section class="hero" aria-labelledby="hero-heading">
				<p class="text-accent section-label hero__eyebrow">Hi, I'm Matthew</p>
				<h1 id="hero-heading">Designer &amp; Front-end Developer.</h1>
				<p class="hero__subheading">
					I design Shopify storefronts and marketing assets, build the shared
					components they run on, and stay on for hundreds of retailers when
					something needs fixing.
				</p>
				<ul class="badge-list hero__badges">
					<li class="badge">
						<span class="badge__full">{careerHighlights.experience}</span>
						<span class="badge__compact">{careerHighlights.experienceCompact}</span>
					</li>
					<li class="badge">
						<span class="badge__full">{careerHighlights.storefronts}</span>
						<span class="badge__compact">{careerHighlights.storefrontsCompact}</span>
					</li>
					<li class="badge">
						<span class="badge__full">{careerHighlights.releases}</span>
						<span class="badge__compact">{careerHighlights.releasesCompact}</span>
					</li>
				</ul>
			</section>
		</div>

		<div class="section-group">
			<PhilosophySection />
			<AboutSection />
		</div>
	</main>

	<Footer />
</BaseLayout>
