---
import AboutSection from '../components/AboutSection.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PhilosophySection from '../components/PhilosophySection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { careerHighlights, projectAccents } from '../lib/site.ts';
---

<BaseLayout accentColor={projectAccents.home}>
	<Header />

	<main id="main">
		<div class="container">
			<section class="hero" aria-labelledby="hero-heading">
				<p class="text-accent section-label hero__eyebrow">Hi, I'm Matthew</p>
				<h1 id="hero-heading">Frontend Developer &amp; Designer.</h1>
				<p class="hero__subheading">
					I design and build digital experiences for retailers and local businesses, where visual design, accessibility, and front-end development meet.
				</p>
				<ul class="badge-list hero__badges">
					<li class="badge">{careerHighlights.experience}</li>
					<li class="badge">{careerHighlights.storefronts}</li>
					<li class="badge">{careerHighlights.releases}</li>
				</ul>
			</section>
		</div>

		<div class="section-group">
			<PhilosophySection />
			<AboutSection />
		</div>
	</main>

	<Footer />
</BaseLayout>
