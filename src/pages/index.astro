---
import AboutSection from '../components/AboutSection.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PhilosophySection from '../components/PhilosophySection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { careerHighlights, projectAccents } from '../lib/site.ts';

// Desktop shows each highlight as one pill. Smaller screens split it into a
// large number and a label (e.g. "500+" / "Storefronts Supported").
const heroStats = [
	{ full: careerHighlights.experience, compact: careerHighlights.experienceCompact },
	{ full: careerHighlights.storefronts, compact: careerHighlights.storefrontsCompact },
	{ full: careerHighlights.releases, compact: careerHighlights.releasesCompact },
].map(({ full, compact }) => {
	const [value, ...rest] = full.split(' ');
	return { full, compact, value, label: rest.join(' ') };
});
---

<BaseLayout
	accentColor={projectAccents.home}
	title="Matthew, Designer & Front-end Developer"
	description="Designer and front-end developer. I design and build Shopify storefronts, shared components, and brand work, and keep them accessible after launch."
>
	<Header />

	<main id="main" class="page-home">
		<div class="container">
			<section class="hero" aria-labelledby="hero-heading">
				<p class="text-accent section-label hero__eyebrow">Hi, I'm Matthew</p>
				<h1 id="hero-heading">
					Designer &amp; <span class="hero__nowrap">Front-end</span> Developer.
				</h1>
				<p class="hero__subheading">
					I care about how something looks, how it gets built, and how it holds
					up after launch. That's the work I'm interested in, because who doesn't
					love making an idea come to life?
				</p>
				<ul class="badge-list hero__badges">
					{
						heroStats.map((stat) => (
							<li class="badge">
								<span class="badge__full">{stat.full}</span>
								<span class="badge__compact">{stat.compact}</span>
								<span class="badge__stat">
									<span class="badge__value">{stat.value}</span>
									<span class="badge__label">{stat.label}</span>
								</span>
							</li>
						))
					}
				</ul>
			</section>
		</div>

		<div class="section-group">
			<PhilosophySection />
			<AboutSection />
		</div>
	</main>

	<Footer />
</BaseLayout>
